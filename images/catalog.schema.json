{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VDIForge Image Catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "images"
  ],
  "properties": {
    "schemaVersion": {
      "const": "vdiforge.io/image-catalog/v1alpha1"
    },
    "images": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "defaultVersion",
          "allowedRoles",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ubuntu-(base|developer|devops)$"
          },
          "displayName": {
            "type": "string"
          },
          "defaultVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "description": {
            "type": "string"
          },
          "allowedRoles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vdi-user",
                "vdi-developer",
                "vdi-devops",
                "vdi-admin"
              ]
            },
            "minItems": 1
          },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "version",
                "ubuntuRelease",
                "architecture",
                "artifactFormat",
                "lifecycle",
                "manifestPath"
              ],
              "properties": {
                "version": {
                  "type": "string"
                },
                "ubuntuRelease": {
                  "type": "string"
                },
                "architecture": {
                  "const": "amd64"
                },
                "artifactFormat": {
                  "const": "qcow2"
                },
                "lifecycle": {
                  "enum": [
                    "candidate",
                    "available",
                    "deprecated",
                    "blocked"
                  ]
                },
                "manifestPath": {
                  "type": "string"
                },
                "sourcePvcName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              }
            }
          }
        }
      }
    }
  }
}
